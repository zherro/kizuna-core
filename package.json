{
  "name": "@kizuna/core",
  "version": "0.0.1",
  "description": "Configuration-driven framework for Next.js + PostgREST",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./client": "./dist/client/index.js",
    "./server": "./dist/server/index.js",
    "./server/email": "./dist/server/email/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "kizuna": "node cli"
  },
  "dependencies": {},
  "peerDependencies": {
    "nodemailer": "^7 || ^8",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-markdown": "^9 || ^10",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "nodemailer": { "optional": true }
  },
  "devDependencies": {
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "nodemailer": "^8.0.7",
    "react-markdown": "^10.1.0",
    "typescript": "^5"
  },
  "keywords": [
    "next.js",
    "postgrest",
    "configuration",
    "crud",
    "forms",
    "screens"
  ]
}
